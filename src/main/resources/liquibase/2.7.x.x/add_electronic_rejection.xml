<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
	  http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

	<changeSet author="CIV developer Group" id="2403011">
		<preConditions onFail="MARK_RAN">
			<not>
				<columnExists tableName="electronic_order"
					columnName="reject_reason" />
			</not>
		</preConditions>
		<addColumn schemaName="clinlims"
			tableName="electronic_order">
			<column name="reject_reason" type="varchar (255)">
				<constraints nullable="true" />
			</column>
		</addColumn>
		<addColumn schemaName="clinlims"
			tableName="electronic_order">
			<column name="reject_reason_id" type="varchar (255)">
				<constraints nullable="true" />
			</column>
		</addColumn>
		<addColumn schemaName="clinlims"
			tableName="electronic_order">
			<column name="reject_comment" type="varchar (255)">
				<constraints nullable="true" />
			</column>
		</addColumn>
		<setColumnRemarks columnName="reject_reason_id"
			remarks="Id from qa_event table" tableName="electronic_order" />
	</changeSet>

	<changeSet author="CIV developer Group" id="24101501">
		<preConditions onFail="MARK_RAN">
			<tableExists schemaName="clinlims"
				tableName="electronic_order" />
			<not>
				<columnExists tableName="electronic_order"
					columnName="collection_date" />
			</not>
		</preConditions>
		<addColumn schemaName="clinlims"
			tableName="electronic_order">
			<column name="collection_date" type="datetime">
				<constraints nullable="true" />
			</column>
		</addColumn>
		<addColumn schemaName="clinlims"
			tableName="electronic_order">
			<column name="organization_id" type="numeric">
				<constraints nullable="true" />
			</column>
		</addColumn>
		<setColumnRemarks columnName="organization_id"
			remarks="Id from organization table" tableName="electronic_order" />
	</changeSet>
	<changeSet author="CIV developer Group" id="24101502">
		<preConditions onFail="MARK_RAN">
			<tableExists schemaName="clinlims"
				tableName="electronic_order" />
			<columnExists tableName="electronic_order"
				schemaName="clinlims" columnName="organization_id" />
		</preConditions>
		<createIndex indexName="index_eorder_organization_id"
			tableName="electronic_order" schemaName="clinlims">
			<column name="organization_id" />
		</createIndex>
	</changeSet>

	<changeSet author="CIV developer Group" id="24102201">
		<preConditions onFail="MARK_RAN">
			<columnExists tableName="electronic_order"
				columnName="reject_reason" />
		</preConditions>
		<renameColumn schemaName="clinlims"
			tableName="electronic_order" oldColumnName="reject_reason"
			newColumnName="rejection_author" />
		<modifyDataType schemaName="clinlims"
			tableName="electronic_order" columnName="reject_reason_id"
			newDataType="numeric" />
		<createIndex indexName="index_reject_reason_id"
			tableName="electronic_order" schemaName="clinlims">
			<column name="reject_reason_id" />
		</createIndex>
	</changeSet>

</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
	  http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
	<changeSet author="CIV developer Group" id="20260310-01">
		<preConditions onFail="MARK_RAN">
			<sqlCheck expectedResult="0">SELECT count(*) FROM clinlims.site_information WHERE name = 'serology control'</sqlCheck>
		</preConditions>
		<comment>Add serology control setting for VL sample entry</comment>
		<insert schemaName="clinlims" tableName="site_information">
			<column name="id" valueSequenceNext="site_information_seq" />
			<column name="name" value="serology control" />
			<column name="lastupdated" valueComputed="${now}" />
			<column name="description" value="Enable serology check on VL sample entry" />
			<column name="value" value="false" />
			<column name="encrypted" value="false" />
			<column name="domain_id" valueComputed="(SELECT id FROM site_information_domain WHERE name = 'sampleEntryConfig')" />
			<column name="value_type" value="boolean" />
			<column name="instruction_key" value="instructions.sampleEntry.serologyControl" />
			<column name="group" value="0" />
			<column name="description_key" value="siteInfo.serology.control" />
		</insert>
	</changeSet>
</databaseChangeLog>
